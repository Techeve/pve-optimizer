[Unit]
Description=pve-optimizer — ergaenzt IO-Begrenzungen neuer Proxmox-VMs
Documentation=https://gitlab.techeve.de/techeve/pve-optimizer
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/pve-optimizer -config /etc/pve-optimizer/config.yaml
Restart=on-failure
RestartSec=10s

# Geheimnisse gehoeren nicht in die Konfiguration, sondern hierhin.
# Datei mit Rechten 0600 anlegen, je nach Bedarf:
#   PVE_OPTIMIZER_TOKEN_SECRET=...   nur fuer mode: api
#   PVE_OPTIMIZER_SMTP_PASSWORD=...  nur wenn der Mailserver eine
#                                    Anmeldung verlangt (Dienst-Monitor)
EnvironmentFile=-/etc/pve-optimizer/secret.env

StateDirectory=pve-optimizer
NoNewPrivileges=true
PrivateTmp=true

# ProtectSystem=full legt /etc read-only — und damit auch /etc/pve, wo die
# VM-Konfigurationen liegen. Der Dienst startet dann zwar, kann aber nichts
# schreiben ("Read-only file system"). Der Cluster-Dateibaum muss deshalb
# ausdrücklich freigegeben werden.
ProtectSystem=full
ReadWritePaths=/etc/pve

[Install]
WantedBy=multi-user.target
